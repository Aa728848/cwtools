<?xml version="1.0" encoding="utf-8"?>
<!--
  Tests build game instances that mutate process-global singletons
  (scopeManager, modifierCategoryManager). Run them serially to avoid
  cross-test races; Expecto defaults to parallel execution.
-->
<RunSettings>
  <RunConfiguration>
    <DisableParallelization>true</DisableParallelization>
  </RunConfiguration>
  <Expecto>
    <parallel>false</parallel>
  </Expecto>
</RunSettings>
